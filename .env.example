# App
BETTER_AUTH_SECRET="<generate-a-random-secret>"
VITE_BETTER_AUTH_URL="http://localhost:3000"

# Browser
VITE_CONVEX_URL="http://127.0.0.1:3210"
VITE_CONVEX_API_URL="http://127.0.0.1:3210/http"
VITE_CONVEX_SITE_URL="http://127.0.0.1:3211"
# Required for generated image loading and optimization.
# Point this at your public asset domain or a publicly readable local S3/MinIO bucket URL.
VITE_R2_PUBLIC_BASE_URL=""
VITE_POSTHOG_HOST=""
VITE_POSTHOG_KEY=""
VITE_ENABLE_VOICE_INPUT="false"
VITE_ENABLED_INTERNAL_PROVIDERS="openai,google,xai"
# Optional OpenRouter-only model groups in the same list:
# openrouter, openrouter-deepseek, openrouter-moonshot, openrouter-zai,
# openrouter-qwen, openrouter-xiaomi, openrouter-minimax

# Auth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Outbound email from the app server
EMAIL_PROVIDER="resend"
EMAIL_FROM="noreply@silkchat.dev"
RESEND_API_KEY=""

# Convex only
ENCRYPTION_KEY="<generate-a-random-secret>"
STT_PROVIDER="google"
GOOGLE_INTERNAL_PROVIDER="ai-studio"
GOOGLE_AI_STUDIO_API_KEY="AIza..."
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_VERTEX_CREDENTIALS_JSON=""
GOOGLE_VERTEX_LOCATION="us-central1"
GOOGLE_SPEECH_LOCATION="us"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
XAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
FAL_API_KEY=""
ARTIFICIAL_ANALYSIS_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible storage for Convex R2 component
R2_FORCE_PATH_STYLE="true"
R2_BUCKET="intern3-user-files"
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"

# Optional built-in search providers
FIRECRAWL_API_KEY=""
BRAVE_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Prototype credits
MONTHLY_CREDITS_FREE="200"
MONTHLY_CREDITS_PRO="1500"
MONTHLY_PRO_CREDITS="100"

# Notes
# 1. Local infra: `docker compose up -d`
# 2. One-time Convex local deployment setup: `bunx convex dev --configure existing --dev-deployment local --once`
# 3. Start Convex locally with `bunx convex dev --local`
#    Local Convex uses separate ports by default:
#    `VITE_CONVEX_URL=http://127.0.0.1:3210`
#    `VITE_CONVEX_SITE_URL=http://127.0.0.1:3211`
# 4. Start the app with `bun run dev`
# 5. Prefer leaving `CONVEX_DEPLOY_KEY` unset in local files to avoid accidental cloud deploy targeting.
