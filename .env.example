# App
BETTER_AUTH_SECRET="<generate-a-random-secret>"
VITE_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_ADDITIONAL_HOSTS=""
DEV_PUBLIC_URL=""
CLOUDFLARE_TUNNEL_TOKEN=""

# Browser
VITE_CONVEX_URL="https://your-cloud-dev-deployment.convex.cloud"
VITE_CONVEX_API_URL="https://your-cloud-dev-deployment.convex.site"
VITE_CONVEX_SITE_URL="https://your-cloud-dev-deployment.convex.site"
# Required for generated image loading and optimization.
# Point this at your public R2 asset domain.
VITE_R2_PUBLIC_BASE_URL=""
VITE_POSTHOG_HOST=""
VITE_POSTHOG_KEY=""
VITE_GOOGLE_ADS_ID=""
VITE_GOOGLE_SIGNUP_CONVERSION_LABEL=""
VITE_ENABLE_VOICE_INPUT="false"
VITE_ENABLED_INTERNAL_PROVIDERS="openrouter"
# Optional OpenRouter model groups in the same list:
# openrouter-deepseek, openrouter-moonshot, openrouter-zai,
# openrouter-qwen, openrouter-xiaomi, openrouter-minimax

# Auth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Outbound email from the app server
EMAIL_PROVIDER="resend"
EMAIL_FROM="SilkChat <noreply@silkchat.dev>"
RESEND_API_KEY=""

# Visible Cloudflare Turnstile challenge for account export requests
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Convex only
ENCRYPTION_KEY="<generate-a-random-secret>"
# Stable HMAC pepper for account-deletion identity tombstones.
# Set once per deployment before real deletion requests. Do not rotate casually:
# changing it prevents matching old tombstones unless you keep compatibility code.
IDENTITY_FINGERPRINT_PEPPER="<generate-a-random-secret>"
OPENROUTER_API_KEY=""

# Voice transcription only
STT_PROVIDER="google"
GOOGLE_VERTEX_CREDENTIALS_JSON=""
GOOGLE_SPEECH_LOCATION="us"
GROQ_API_KEY=""

# Library image generation only
FAL_KEY=""
# Optional Worker path that streams fal outputs directly to R2. Leave either
# value empty to retain the Convex download-and-upload path.
FAL_R2_INGEST_URL=""
FAL_R2_INGEST_SECRET="<generate-a-random-secret>"
ARTIFICIAL_ANALYSIS_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible storage for Convex R2 component
R2_PUBLIC_BASE_URL=""
R2_FORCE_PATH_STYLE="true"
R2_BUCKET="your-cloud-dev-r2-bucket"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Built-in web search
PERPLEXITY_API_KEY=""

# Hosted usage metering (provider cost in USD; all values are runtime-configurable)
HOSTED_USAGE_5H_USD_FREE="0.10"
HOSTED_USAGE_MONTHLY_USD_FREE="0.50"
HOSTED_USAGE_5H_USD_PRO="1.00"
HOSTED_USAGE_MONTHLY_USD_PRO="18.00"
HOSTED_USAGE_OUTPUT_RESERVE_TOKENS="4096"
HOSTED_USAGE_UNKNOWN_INPUT_USD_PER_1M="10"
HOSTED_USAGE_UNKNOWN_OUTPUT_USD_PER_1M="30"
FAL_USAGE_RESERVATION_USD_DEFAULT="0.005"
# Opt into Fal's pricing estimate endpoint for reservations. Actual billing events
# still reconcile settled usage after webhook completion.
FAL_USAGE_PRICING_ESTIMATE_ENABLED="0"
# Flat upstream cost per deployment-funded web search call ($5 / 1000 calls).
TOOL_USAGE_USD_WEB_SEARCH="0.005"
# Optional override for billing reconciliation. If unset, FAL_KEY is used and
# must have access to Fal Platform billing events.
FAL_ADMIN_API_KEY=""

# Billing
LEMONSQUEEZY_WEBHOOK_SECRET=""
VITE_LEMONSQUEEZY_PRO_CHECKOUT_URL="https://dropsilk-inc.lemonsqueezy.com/checkout/buy/ce001cec-a336-4ee9-97a5-4851895aa43d"
VITE_LEMONSQUEEZY_CUSTOMER_PORTAL_URL="https://dropsilk-inc.lemonsqueezy.com/billing"
