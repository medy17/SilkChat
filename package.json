{
    "name": "silkchat",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "personas:sync-builtins": "bun scripts/sync-built-in-personas.mjs",
        "silk-app:build": "bun scripts/build-silk-app-runtime.mjs",
        "predev": "bun scripts/sync-built-in-personas.mjs",
        "dev": "bun scripts/run-cloud-dev-app.mjs",
        "prebuild": "bun scripts/sync-built-in-personas.mjs && bun run silk-app:build",
        "test": "vitest run",
        "test:bun-local": "bun --bun vitest run tests/lib/local-image-optimizer-server.spec.ts tests/lib/local-image-optimizer.spec.ts tests/lib/cloud-dev-tunnel.spec.ts tests/lib/dev-runner-ui.spec.ts",
        "fal:r2:worker:typecheck": "tsc -p workers/fal-r2-ingest/tsconfig.json",
        "fal:r2:worker:deploy:cloud-dev": "wrangler deploy --config workers/fal-r2-ingest/wrangler.jsonc --env=\"\"",
        "fal:r2:worker:deploy:staging": "wrangler deploy --config workers/fal-r2-ingest/wrangler.jsonc --env staging",
        "fal:r2:worker:deploy:production": "wrangler deploy --config workers/fal-r2-ingest/wrangler.jsonc --env production",
        "local:image-optimizer": "bun scripts/local-image-optimizer.ts",
        "precloud:dev:app": "bun scripts/sync-built-in-personas.mjs",
        "cloud:dev:app": "bun scripts/run-cloud-dev-app.mjs",
        "cloud:dev:push": "bun scripts/push-cloud-dev.mjs",
        "staging:push": "bun scripts/push-staging.mjs",
        "staging:deploy": "bun scripts/deploy-sync.mjs staging",
        "staging:vercel:deploy": "bun scripts/deploy-staging-vercel.mjs",
        "prod:push": "bun scripts/push-prod.mjs",
        "prod:deploy": "bun scripts/deploy-sync.mjs prod",
        "env:convex:cloud-dev:push": "bun scripts/push-convex-env.mjs cloud-dev",
        "env:convex:staging:push": "bun scripts/push-convex-env.mjs staging",
        "env:convex:prod:push": "bun scripts/push-convex-env.mjs prod",
        "build": "vite build",
        "start": "bun .output/server/index.mjs",
        "lint": "biome check --write",
        "check-types": "tsc --noEmit",
        "postinstall": "patch-package --error-on-fail && bun scripts/fix-tanstack-start-plugin-core.mjs",
        "prepare": "husky"
    },
    "keywords": [
        "better-auth",
        "tanstack",
        "vite",
        "react"
    ],
    "author": "silkchat",
    "license": "AGPL-3.0-only",
